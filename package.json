{
    "name": "vsd",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "lint:ts": "ng lint",
        "lint:ts:fix": "ng lint --fix",
        "lint": "bun run lint:ts && bun run lint:scss",
        "lint:fix": "bun run lint:ts:fix && bun run lint:scss:fix",
        "lint:scss": "stylelint \"**/*.scss\"",
        "lint:scss:fix": "stylelint \"**/*.scss\" --fix",
        "init:git:hooks": ".github/scripts/setup_hooks.sh"
    },
    "private": true,
    "packageManager": "npm@11.12.0",
    "dependencies": {
        "@angular/common": "^21.2.11",
        "@angular/compiler": "^21.2.11",
        "@angular/core": "^21.2.11",
        "@angular/forms": "^21.2.11",
        "@angular/platform-browser": "^21.2.11",
        "@angular/router": "^21.2.11",
        "rxjs": "~7.8.2",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular/build": "^21.2.9",
        "@angular/cli": "^21.2.9",
        "@angular/compiler-cli": "^21.2.11",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/postcss": "^4.2.4",
        "angular-eslint": "21.3.1",
        "eslint": "^10.0.3",
        "jsdom": "^29.1.1",
        "postcss": "^8.5.13",
        "prettier": "^3.8.3",
        "tailwindcss": "^4.2.4",
        "typescript": "~5.9.3",
        "typescript-eslint": "8.56.1",
        "vitest": "^4.1.5"
    }
}
